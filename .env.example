# Copier en .env puis remplacer chaque "change-me". Ne jamais commiter .env.

# --- PostgreSQL (superutilisateur, utilisé seulement par le conteneur postgres et le script d'init) ---
# Nom du superutilisateur PostgreSQL.
POSTGRES_USER=postgres
# Mot de passe du superutilisateur PostgreSQL.
POSTGRES_PASSWORD=change-me
# Base créée au premier démarrage ; le script d'init en donne la propriété à veille_app.
POSTGRES_DB=veille

# --- Rôles applicatifs (créés par infra/postgres/init/01-roles.sh au premier démarrage) ---
# Mot de passe de veille_app, rôle Laravel propriétaire du schéma (migrations).
APP_DB_PASSWORD=change-me
# Mot de passe de veille_worker, rôle du worker Python, sans droit DDL.
WORKER_DB_PASSWORD=change-me

# --- vLLM ---
# Modèle servi, téléchargé au premier démarrage dans le volume du projet hf_cache.
# Qwen/Qwen3-14B-AWQ (visé à l'origine) ne tient pas sur la RTX 5070 : OOM à la conversion
# des poids AWQ. Qwen/Qwen3-8B-AWQ tient et donne un meilleur français que Qwen/Qwen3-4B
# (repli, avec VLLM_GPU_MEMORY_UTILIZATION=0.80). Voir infra/vllm/README.md.
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
# Longueur de contexte maximale (tokens) ; la réduire si le KV cache ne tient pas (minimum 4096).
VLLM_MAX_MODEL_LEN=8192
# Part de la VRAM réservée par vLLM (0 à 1). 0.80 pour Qwen3-8B-AWQ (0.85 tombe en OOM au warm-up, voir infra/vllm/README.md).
VLLM_GPU_MEMORY_UTILIZATION=0.80
# 0 : vLLM télécharge le modèle absent du cache (premier démarrage). 1 : aucun accès à
# Hugging Face, le modèle doit déjà être dans hf_cache. Repasser à 1 une fois le modèle téléchargé.
VLLM_HF_HUB_OFFLINE=0
# URL de l'API compatible OpenAI, vue depuis le réseau Compose.
VLLM_BASE_URL=http://vllm:8000/v1

# --- Laravel (service app ; ces valeurs priment sur web/.env) ---
# Clé de chiffrement Laravel, obligatoire. Générer avec :
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Environnement Laravel. production par défaut : nginx est joignable depuis le LAN.
# local seulement sur une machine isolée (Filament ouvre alors /admin à tout utilisateur connecté).
APP_ENV=production
# Pages d'erreur détaillées (trace, variables). false par défaut ; true seulement en debug ponctuel.
APP_DEBUG=false
# UID/GID de l'utilisateur hôte propriétaire de web/ (commande `id -u` / `id -g`),
# pour que PHP-FPM puisse écrire dans web/storage et web/bootstrap/cache.
APP_UID=1000
APP_GID=1000

# --- Collecte (service worker-cron) ---
# Planification cron de la collecte (supercronic), dans le fuseau COLLECT_TZ. Défaut : tous les jours à 6 h.
COLLECT_SCHEDULE=0 6 * * *
# Fuseau horaire de la planification.
COLLECT_TZ=Europe/Paris
